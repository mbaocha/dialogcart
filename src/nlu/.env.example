# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit it.

# Anthropic API key (get from console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: pin reference date for deterministic test runs.
# Prefer `python run.py` (sets LUMA_TEST_NOW from core.tests.harness.test_clock).
# LUMA_TEST_NOW=2026-07-01T10:00:00Z

# Optional: server config
# PORT=9002
# LOG_LEVEL=INFO
